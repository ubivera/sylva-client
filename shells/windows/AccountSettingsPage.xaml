<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ubivera.Sylva.Client.AccountSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ubivera.Sylva.Client"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="20" MaxWidth="560" HorizontalAlignment="Center">
            <TextBlock Text="Account" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <!-- Display name -->
            <StackPanel Spacing="8">
                <TextBlock Text="Display name" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox x:Name="DisplayNameBox" Header="Your name" />
                <Button x:Name="SaveNameButton" Content="Save name" Click="OnSaveNameClick" />
            </StackPanel>

            <!-- Email -->
            <StackPanel Spacing="8">
                <TextBlock Text="Email" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="CurrentEmailText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="NewEmailBox" Header="New email" />
                <PasswordBox x:Name="EmailPasswordBox" Header="Current password (to confirm)" />
                <Button x:Name="ChangeEmailButton" Content="Change email" Click="OnChangeEmailClick" />
            </StackPanel>

            <!-- Password -->
            <StackPanel Spacing="8">
                <TextBlock Text="Password" Style="{StaticResource SubtitleTextBlockStyle}" />
                <PasswordBox x:Name="CurrentPwBox" Header="Current password" />
                <PasswordBox x:Name="NewPwBox" Header="New password" />
                <PasswordBox x:Name="ConfirmPwBox" Header="Confirm new password" />
                <Button x:Name="ChangePwButton" Content="Change password" Click="OnChangePasswordClick" />
            </StackPanel>

            <!-- Session -->
            <StackPanel Spacing="8">
                <TextBlock Text="Session" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Sign out" Click="OnSignOutClick" />
                    <Button Content="Forget this server" Click="OnForgetClick" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
