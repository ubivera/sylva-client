<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ubivera.Sylva.Client.MyDevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ubivera.Sylva.Client"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32" MaxWidth="560" HorizontalAlignment="Center" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Your devices" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

        <InfoBar Grid.Row="1" x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Margin="0,0,0,8" />
        <ProgressRing Grid.Row="1" x:Name="Busy" IsActive="False" HorizontalAlignment="Center" />

        <ListView Grid.Row="2" x:Name="DeviceList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DeviceRow">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Revoke" Tag="{x:Bind DeviceId}"
                                Click="OnRevokeClick" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="2" x:Name="EmptyText" Text="No devices yet."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

        <Button Grid.Row="3" Content="Sign out" Click="OnSignOutClick" Margin="0,12,0,0" />
    </Grid>
</Page>
